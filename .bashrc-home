#!/bin/bash

# Para los usuarios de red
# En tu bashrc_master
if [[ "$USER" == *"-ipa" ]]; then
    # Permite que coexistan múltiples tickets para distintos usuarios
    export KRB5CCNAME="DIR:/tmp/krb5cc_collection_${USER}"
    mkdir -p /tmp/krb5cc_collection_${USER}
fi

# --- 1. Identidad y Máscara ---
umask 002
export GIT_DISCOVERY_ACROSS_FILESYSTEM=1

parse_git_branch() {
    local branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    [[ -n "$branch" ]] && echo -e " \033[0;33m($branch)\033[0m"
}
export -f parse_git_branch 
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Versión 2026 para doble remoto
# git-sync() {
#     local branch=$(git branch --show-current)
#     echo "Sincronizando rama: $branch..."
#     git pull --rebase origin $branch && \
#     git push origin $branch && \
#     git push nas-backup $branch
# }

# git-deploy-lab() {
#     local branch=$(git branch --show-current)
#     local lab_path="/mnt/build-output/Repos/hwbus-io.git"
    
#     echo "Desplegando rama '$branch' en Buildlab..."
    
#     # 1. Enviar cambios de la rama activa al repositorio de buildlab
#     git push buildlab "$branch" || return 1
    
#     # 2. Forzar el checkout en el laboratorio a la rama actual de la WS
#     echo "Cambiando a la rama '$branch' en el directorio de compilación..."
#     ssh builder@buildlab "git -C $lab_path checkout -f $branch"
# }

# Cargar definiciones globales de Rocky Linux
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Ajuste de PATH dinámico
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# --- 2. Lógica de Prompt (Diferenciado por Usuario) ---
# --- 2. Lógica de Prompt (Simplificado para Repositorios) ---
if [ "$USER" == "raul" ]; then
    COLOR_SIMBOLO="\[\033[0;32m\]" # Verde para local
else
    COLOR_SIMBOLO="\[\033[0;36m\]" # Cian para raul-ipa
fi

RESET="\[\033[0m\]"
AZUL="\[\033[0;34m\]"

# \W (mayúscula) muestra solo el nombre del directorio actual, no la ruta completa
if [ "$TERM_PROGRAM" == "vscode" ]; then
    export PS1="${AZUL}\W${RESET}\$(parse_git_branch)\n ${COLOR_SIMBOLO}\$${RESET} "
else
    # Para terminal estándar, mantenemos tu estilo de $>
    #export PS1='$(parse_git_branch)'"${COLOR_SIMBOLO}"'\$> '"${RESET}" #hay que corregirla
    export PS1="${AZUL}\W${RESET}\$(parse_git_branch)\n${COLOR_SIMBOLO}\$${RESET} "
fi

# --- 3. Funcion de Administración (virt-admin) ---
vwork() {    
    sudo -u virt-admin /usr/bin/bash --rcfile /var/lib/virt_storage/scripts/bashrc_virt_admin
}

# --- 4. Función de Protección Avanzada para /mnt/
rm() {
    local target_dir="/mnt/datos_raul/"
    local protection_triggered=false

    # Comprobar si algún argumento apunta al disco persistente
    for arg in "$@"; do
        # Resolvemos la ruta absoluta para evitar trucos con rutas relativas
        local abs_path=$(realpath -m "$arg" 2>/dev/null)

        if [[ "$abs_path" == "$target_dir"* ]]; then
            echo -e "\033[1;31m⚠️  ALERTA DE SEGURIDAD\033[0m"
            echo -e "Estás intentando borrar en: \033[1;33m$abs_path\033[0m"
            read -p "¿Confirmas que quieres borrar en el DISCO PERSISTENTE? (s/N): " response

            if [[ "$response" != "s" && "$response" != "S" ]]; then
                echo "Operación cancelada por el usuario."
                return 1
            fi
            protection_triggered=true
        fi
    done

    # 'command rm' evita que la función se llame a sí misma (bucle infinito)
    # Siempre añadimos -i por seguridad extra
    command rm -i "$@"
}

# --- 5. Extensibilidad Local ---
if [ -f ~/.bashrc.local ]; then
    . ~/.bashrc.local
fi

if [ -f ~/.bashrc.local-ipa ]; then
    . ~/.bashrc.local-ipa
fi
