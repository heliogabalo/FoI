[safe]
	directory = /mnt/datos_raul/Repos/*
	directory = /mnt/datos_raul/scripts/*
[init]
	defaultBranch = main
[alias]
    deploy-lab = "!f() { \
        BRANCH=$(git branch --show-current); \
        git push buildlab $BRANCH && \
        ssh builder@buildlab \"git -C /mnt/build-output/Repos/hwbus-io.git checkout -f $BRANCH\"; \
    }; f"
    
    sync-nas = "!f() { \
        BRANCH=$(git branch --show-current); \
        echo \"Sincronizando rama: $BRANCH...\"; \
        git pull --rebase origin $BRANCH && \
        git push origin $BRANCH && \
        git push nas-backup $BRANCH; \
    }; f"